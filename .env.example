# ==============================================================================
# KIRI PROJECT — full-stack environment (Docker compose + local dev)
#
# The app now has a real backend: an Express + PostgreSQL API that also serves
# the built frontend. Records live in Postgres; uploads are stored on the server.
#
# Copy this file to `.env` (same folder) before running `docker compose up`.
# ==============================================================================

# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot in production with the development default.
JWT_SECRET=

# Public port the app is exposed on (docker compose only).
APP_PORT=8080

# Password for the bundled Postgres service (docker compose only).
POSTGRES_PASSWORD=kiri_dev_password

# Comma-separated allowed browser origins. Only needed when the frontend is
# served from a different origin than the API. Same-origin deploys can leave it.
CORS_ORIGINS=http://localhost:8080

# Bootstrap admin account (used only by `npm run seed`).
# DEBT: default password is weak — rotate before going public.
SEED_ADMIN_EMAIL=admin@kiriproject.id
SEED_ADMIN_PASSWORD=kiri-admin

# --- Frontend dev only ---
# Set to point the Vite dev proxy at a non-default API host.
# VITE_API_PROXY_TARGET=http://localhost:4000
# Set to call a separately-hosted API (otherwise the app calls /api same-origin).
# VITE_API_URL=
