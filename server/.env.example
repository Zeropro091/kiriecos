# ==============================================================================
# KIRI PROJECT — BACKEND ENVIRONMENT
#
# Copy this file to `.env` (same folder) before running the server.
# ==============================================================================

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://kiri:kiri_dev_password@127.0.0.1:5433/kiri
# Set to true for hosted Postgres that requires TLS (Neon, Render, Supabase).
DATABASE_SSL=false

# --- Auth ---
# REQUIRED IN PRODUCTION. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The dev default below is intentionally obvious so it is never mistaken for production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Observability ---
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Sentry DSN for error tracking. Leave empty to disable (errors still get logged).
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=development

# --- CORS: comma-separated allowed origins ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Bootstrap admin (used only by `npm run seed`) ---
# DEBT: default admin password is hardcoded in seed.ts. Rotate before production.
SEED_ADMIN_EMAIL=admin@kiriproject.id
SEED_ADMIN_PASSWORD=kiri-admin

# --- Uploads ---
# Directory (relative to server/) where receipt images are stored as files.
# Neon Object Storage (receipt uploads). Leave S3_BUCKET empty to store uploads on local disk.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Frontend (one-domain deploy) ---
# Absolute path to the built frontend (index.html + assets) that this server serves.
# Leave empty in dev (Vite serves the frontend). Set in production, e.g. /app/dist.
FRONTEND_DIST=
