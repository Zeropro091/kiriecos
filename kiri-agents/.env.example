# KIRI Agents — kredensial per-agent.
# Copy ke .env, isi, JANGAN commit.
# Prinsip: satu key = satu agent. Revoke terpisah kalau bocor.

# === Database (Supabase) ===
#Matching Agent pakai kunci read-only (buat role postgres read-only di Supabase)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL_READONLY=postgresql://readonly:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# === LLM (openagentic.id plan GLM5.3) ===
GLM_API_KEY=
GLM_BASE_URL=https://openagentic.id/v1

# === Per-agent API keys (buat di dashboard provider, terpisah) ===
RESEARCH_AGENT_KEY=
CONTENT_AGENT_KEY=
MATCHING_AGENT_KEY=
OPS_AGENT_KEY=

# === Ops Agent only ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === n8n ===
N8N_ENCRYPTION_KEY=
